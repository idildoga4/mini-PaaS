# Mini PaaS — Ortam Değişkenleri
# Bu dosyayı kopyalayın: cp .env.example .env
# .env dosyasını ASLA Git'e commit etmeyin!

# GitHub Personal Access Token
# Almak için: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Gerekli izinler: repo (full control)
GITHUB_TOKEN=your_github_token_here

# GitHub OAuth App credentials
# Oluşturmak için: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Callback URL: http://localhost:5001/api/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT imzalama anahtarı — güçlü ve rastgele bir string yazın
JWT_SECRET=change-this-to-a-strong-random-secret

# Grafana admin şifresi
GRAFANA_PASSWORD=change-this-password


